# Copy to .env.supabase.local (ignored). Fill secrets locally, not in chat.
# Use a dedicated Free Supabase project for ZiyatAI.
APP_ENV=production
APP_URL=https://YOUR_APP_HOST
PASSWORD_RESET_ENABLED=false
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY

# IPv4: use the session pooler connection string from Connect, port 5432.
# Keep sslmode=verify-full. A direct connection also works with IPv6.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# Supabase root CA PEM, with literal \n separators. Certificate verification stays enabled.
DATABASE_SSL_CA=
DATABASE_SCHEMA=ziyatai
DATABASE_POOL_MAX=5

# Supabase Storage -> S3 settings. These are S3 keys, not Auth API keys.
STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_PUBLIC_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=YOUR_PROJECT_REGION
STORAGE_BUCKET=ziyatai-private
STORAGE_ACCESS_KEY=YOUR_SUPABASE_S3_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_SUPABASE_S3_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=true
# S3 lifecycle rules are not supported; the worker cleans quarantine.
STORAGE_LIFECYCLE_MODE=worker
DIRECT_UPLOADS=true
UPLOAD_ORIGIN=https://YOUR_PROJECT_REF.storage.supabase.co

# Configure SMTP inside Supabase Auth, not in this app.
DEFAULT_EXPORT_FONT=Liberation Serif
OPENAI_API_KEY=YOUR_SERVER_SIDE_KEY
OPENAI_MODEL=YOUR_EVALUATED_MODEL
RENDERER_URL=http://renderer:8090
RENDERER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CLAMAV_HOST=clam-update
CLAMAV_PORT=3310
SCAN_REQUIRED=true
ALLOW_DEMO=false
API_GATEWAY=direct
