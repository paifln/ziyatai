{
  "name": "ziyatai",
  "version": "1.0.0",
  "description": "ZiyatAI — private KTP import and differentiated assignments for Kazakhstan teachers",
  "scripts": {
    "predev": "npm run build:lite && npm run licenses:generate",
    "dev": "node --env-file-if-exists=.env.local scripts/dev/start.mjs",
    "build:lite": "node scripts/build/build-lite.mjs",
    "build:worker": "node scripts/build/build-worker.mjs",
    "build": "npm run build:lite && npm run licenses:generate && next build --webpack && node scripts/build/package-web.mjs && npm run check:public",
    "build:netlify": "node scripts/build/prepare-netlify.mjs && npm run build:lite && npm run licenses:generate && next build --webpack && npm run check:public",
    "licenses:generate": "node scripts/build/license-report.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/runtime/start-web.mjs",
    "worker": "tsx --env-file=.env.local apps/worker/index.ts",
    "migrate": "tsx --env-file=.env.local scripts/runtime/migrate.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check:source": "node scripts/checks/check-source.mjs",
    "check:client": "node scripts/checks/check-client-boundary.mjs",
    "check:public": "node --env-file-if-exists=.env.local scripts/checks/check-public-artifacts.mjs",
    "check:deploy": "tsx scripts/deploy/deploy-check.ts",
    "check:railway": "npm --prefix .railway ci && npm --prefix .railway run check",
    "prepare:hosting": "tsx scripts/deploy/prepare-hosting.ts",
    "online:build": "node scripts/deploy/laptop-backend.mjs build",
    "online:start": "node scripts/deploy/laptop-backend.mjs start",
    "online:stop": "node scripts/deploy/laptop-backend.mjs stop",
    "online:status": "node scripts/deploy/laptop-backend.mjs status",
    "online:publish": "node scripts/deploy/laptop-backend.mjs publish",
    "publish:railway": "node scripts/deploy/laptop-backend.mjs publish-railway",
    "lint": "eslint .",
    "test": "vitest run",
    "test:parser": "python -m pytest tests/parser -q",
    "test:security": "python -m pytest tests/security -q",
    "test:browser": "playwright test --config=playwright.browser.config.ts",
    "test:e2e": "playwright test",
    "fixtures": "python scripts/dev/create_fixtures.py",
    "infra:up": "docker compose -f infra/compose.tools-local.yml --env-file .env.local up -d --build",
    "local:setup": "tsx scripts/dev/setup.ts",
    "supabase:check": "tsx scripts/supabase/check.ts",
    "supabase:copy-db": "tsx scripts/supabase/copy-database.ts",
    "supabase:copy-files": "tsx scripts/supabase/copy-files.ts",
    "check:unused": "knip",
    "format:check": "prettier --check app apps/web packages scripts tests .railway/railway.ts",
    "format": "prettier --write app apps/web packages scripts tests .railway/railway.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "docx": "9.11.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.57.0",
    "next": "16.4.3",
    "openai": "7.33.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
