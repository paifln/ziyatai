{
  "name": "ziyatai",
  "version": "1.0.0",
  "description": "ZiyatAI — private KTP import and differentiated assignments for Kazakhstan teachers",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "tsx --env-file=.env.local apps/worker/index.ts",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:parser": "python -m pytest tests/parser -q",
    "test:e2e": "playwright test",
    "fixtures": "python scripts/create_fixtures.py",
    "infra:up": "docker compose -f infra/compose.local.yml --env-file .env.local up -d",
    "local:setup": "tsx scripts/local-setup.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "better-auth": "1.7.7",
    "docx": "9.11.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "nodemailer": "10.1.1",
    "openai": "7.33.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
