# Supply secrets using the hosting secret manager. Never commit populated values.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full
DATABASE_SCHEMA=ziyatai
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
PASSWORD_RESET_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY
APP_ENV=production
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
API_GATEWAY=direct
# Required for Netlify hybrid only. Same proxy secret in Netlify Runtime scope.
NETLIFY_PROXY_SECRET=
NETLIFY_SITE_ID=
APP_URL=https://YOUR_HOST
STORAGE_ENDPOINT=https://YOUR_PRIVATE_S3_ENDPOINT
STORAGE_PUBLIC_ENDPOINT=https://YOUR_PRIVATE_S3_ENDPOINT
STORAGE_REGION=YOUR_REGION
# true for Garage/R2/path style; false for virtual-hosted S3 endpoints.
STORAGE_FORCE_PATH_STYLE=true
# provider applies S3 lifecycle; worker explicitly uses the monitored quarantine sweep.
STORAGE_LIFECYCLE_MODE=worker
STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
STORAGE_ACCESS_KEY=YOUR_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_SECRET_KEY
DEFAULT_EXPORT_FONT=Liberation Serif
OPENAI_API_KEY=YOUR_SERVER_SIDE_KEY
OPENAI_MODEL=YOUR_EVALUATED_STRUCTURED_OUTPUT_MODEL_ID
PYTHON_PATH=python
SOFFICE_PATH=libreoffice
TESSERACT_PATH=tesseract
CLAMSCAN_PATH=clamscan
CLAMAV_HOST=clam-update
CLAMAV_PORT=3310
SCAN_REQUIRED=true
MAX_UPLOAD_MB=25
DIRECT_UPLOADS=true
# Public storage origin for CSP at frontend build time (not a credential).
UPLOAD_ORIGIN=https://YOUR_PRIVATE_S3_ENDPOINT
DAILY_AI_LIMIT=20
GLOBAL_DAILY_AI_LIMIT=200
DAILY_AI_TOKEN_LIMIT=200000
GLOBAL_DAILY_AI_TOKEN_LIMIT=2000000
MAX_AI_TOKENS=16000
WORKER_POLL_MS=1000
JOB_LEASE_SECONDS=180
ALLOW_DEMO=false
# Optional isolated Docker adapters for local worker (empty inside worker image).
PARSER_CONTAINER_IMAGE=
RENDER_CONTAINER_IMAGE=
FONT_DIRECTORY=
# Required in production: private renderer on a separate internal network.
RENDERER_URL=http://renderer:8090
RENDERER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Compose-only settings; do not expose these to browsers.
RELEASE=YOUR_COMMIT_SHA
APP_HOST=YOUR_HTTPS_HOSTNAME
CADDY_CONFIG=./Caddyfile
LICENSED_FONT_DIR=/opt/ziyatai/licensed-fonts
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
