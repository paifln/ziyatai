# New installations only: do not attach a Debian/glibc data directory here.
# Use pg_dump/pg_restore and verify collation/search behavior when migrating.
FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
RUN CGO_ENABLED=0 go install github.com/tianon/gosu@6456aaa0f3c854d199d0f037f068eb97515b7513
COPY infra/go-notices.sh /go-notices.sh
RUN cd /go/pkg/mod/github.com/tianon/gosu@* && sh /go-notices.sh > /THIRD-PARTY-NOTICES.txt

FROM postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
# Preserve the official entrypoint and replace only its privilege-drop helper
# compiled with a maintained Go runtime. PostgreSQL itself is unchanged.
COPY --from=build /go/bin/gosu /usr/local/bin/gosu
COPY --from=build /THIRD-PARTY-NOTICES.txt /usr/share/doc/gosu/THIRD-PARTY-NOTICES.txt
