FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY infra/caddy/go.mod infra/caddy/go.sum ./
RUN go mod download
COPY infra/caddy/main.go ./
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags="-s -w" -o /caddy .
COPY infra/go-notices.sh /go-notices.sh
RUN sh /go-notices.sh > /THIRD-PARTY-NOTICES.txt

FROM caddy:2.11.7@sha256:685ae3d7c34d9b5f8caeddc5d14051db7bbd88ff1f5a2fa0c16bd8ca328fb7af
COPY --from=build /caddy /usr/bin/caddy
COPY --from=build /src/go.mod /src/go.sum /usr/share/doc/ziyatai-proxy/
COPY --from=build /THIRD-PARTY-NOTICES.txt /usr/share/doc/ziyatai-proxy/
